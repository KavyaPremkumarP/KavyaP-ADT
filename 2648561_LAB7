/* LOGICAL OPERATORS */

db.products.find({
    $and: [
        { category: "Food" },
        { organic_type: "Organic" }
    ]
})

db.products.find({
    $or: [
        { category: "Food" },
        { category: "Dairy" }
    ]
})

db.products.find({
    organic_type: {
        $not: {
            $eq: "Organic"
        }
    }
})

db.products.find({
    $nor: [
        { category: "Food" },
        { category: "Dairy" }
    ]
})


/* RELATIONAL OPERATORS */

db.products.find({
    quantity: { $gt: 50 }
})

db.products.find({
    quantity: { $lt: 50 }
})

db.products.find({
    quantity: { $eq: 50 }
})

db.products.find({
    quantity: { $ne: 50 }
})

db.products.find({
    quantity: { $gte: 50 }
})

db.products.find({
    quantity: { $lte: 50 }
})

db.products.find({
    product_id: { $in: [11, 22, 33] }
})

db.products.find({
    product_id: { $nin: [11, 22, 33] }
})


/* UPDATE */

db.products.updateOne(
    { product_id: 11 },
    {
        $set: {
            product_name: "Organic Wheat"
        }
    }
)

db.products.updateMany(
    { category: "Food" },
    {
        $set: {
            organic_type: "Organic"
        }
    }
)


/* DELETE */

db.products.deleteOne({
    product_id: 55
})

db.products.deleteMany({
    category: "Beverage"
})


/* AGGREGATION */

db.products.aggregate([
    {
        $match: {
            category: "Food"
        }
    }
])

db.products.aggregate([
    {
        $group: {
            _id: "$category",
            total: {
                $sum: 1
            }
        }
    }
])

db.products.aggregate([
    {
        $group: {
            _id: null,
            average: {
                $avg: "$quantity"
            }
        }
    }
])

db.products.aggregate([
    {
        $count: "total_products"
    }
])

db.products.aggregate([
    {
        $project: {
            product_name: 1,
            category: 1,
            organic_type: 1
        }
    }
])

db.products.aggregate([
    {
        $sort: {
            product_id: 1
        }
    }
])

db.products.aggregate([
    {
        $unwind: "$category"
    }
])
